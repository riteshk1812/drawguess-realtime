# Server
PORT=3001
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3001
LOG_LEVEL=info
NODE_ENV=development

# Identity reservation after a disconnect, in milliseconds.
RECONNECT_GRACE_MS=30000

# Optional. Leave empty for the default single-process in-memory mode.
# Local Docker Compose values are development placeholders, not production secrets.
REDIS_URL=
DATABASE_URL=

# Optional browser override. Empty means "same origin" (Vite proxy in dev, server in prod).
# VITE_SOCKET_URL=http://localhost:3001
